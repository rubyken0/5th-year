#This is a computer model that predicts changes to population in a zombievirus, will print how  
#assumptions- 

#inputs
pop=int(input("Enter the starting population in thousands: "))*1000
zombie_deaths=float(input("Enter zombie death rate per day: "))/100
transmission_method=input("Enter the transmission method between zombies and humans; bite,airborne or contaminated surfaces (enter as 'B', 'A' or 'CS'): ").lower()
cure_rate=float(input("Enter the percent that infected are being cured per day: "))/100   #cure rate * infected
interaction_rate=float(input("Enter the percent of humans per day that are interacting with zombies: "))/100     #rate * pop
migration_rate=float(input("Enter the percent of humans per day that are migrating from the area: "))/100
food_consumption=float(input("Enter the rate that food is being consumed on a daily basis, in percent: "))/100

days=int(input("Enter amount of days to be modelled:"))

if transmission_method=="b":
    transmission=0.7
elif transmission_method=="a":
    transmission=1
else:
    transmission=0.5

food=1

transmission_rate=(0.06*transmission+ 0.04*interaction_rate)

infection_rate=(0.9*transmission_rate+  0.1*migration_rate)




infected=1
cured=0
dead_zombies=0

for i in range(1,days+1):
    food-=food_consumption
    
    susceptible = pop - infected - cured - dead_zombies
    
    new_infections = infection_rate * (infected * susceptible / pop)

    new_cured = cure_rate * infected

    new_zombie_deaths = zombie_deaths * infected

    infected += new_infections - new_cured - new_zombie_deaths
    cured += new_cured
    dead_zombies += new_zombie_deaths

    
    
    
    if food<=0:
        print("Food has run out, population will start to decline much faster")
        infected=infected*1.1

    print(f" day {i} infected: {round(new_infections,2)}, cured: {round(new_cured,0)}, zombie killed: {round(new_zombie_deaths,0)}")
    
  

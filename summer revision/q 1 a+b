#creating empty brackets so they can be appended later
athletes=[]
distances=[]
#creating functions, using while true so the loop continues till the user enters end or -1, adding names to list if loop doesnt break
def athlete_names():
    while True:
        name=input("Please enter athlete name and enter 'end' or 'End' when complete: ").capitalize().strip()
        if name=="End":
            break
        else:
            athletes.append(name)
def athlete_distances():
    while True:
        distance=float(input("Please enter athlete distance in km enter '-1' when complete: "))
        if distance==-1:
            break
        else:
            distances.append(distance)
#calling functions, printing lists
athlete_names()
print()
athlete_distances()
print(f"\nAthlete names are: {athletes}")
print(f"Athlete distances are: {distances}")
#using conditionals to check if lists are same length, if not printing an error and using a nested conditional to allow user to enter missing name/distance and cofrespodning index
if len(athletes) != len(distances):
    print("Error")
    if len(athletes) > len(distances):
        print("You have entered more athlete names than athlete distances")
        missing_dist=float(input("Please enter the athlete distance that was left out: "))
        index=int(input("What is the index position of the missing distance: "))
        distances.insert(index,missing_dist)
    if len(distances) > len(athletes):
        print("You have entered more athlete distances than athlete names")
        missing_name=input("Please enter the athlete name that was left out: ").capitalize()
        index=int(input("What is the index position of the missing name: "))
        athletes.insert(index,missing_name)
    print(f"\nUpdated athlete names are: {athletes}")
    print(f"Updated athlete distances are: {distances}")
#analysing the data using built in functions and indexing

guest_list=[]
nights_list=[]
def guests():
    while True:
        names=input("enter guest name and enter 'end' or 'End' when done: ").capitalize()
        guest_list.append(names)
        if names=="End":
            break
def nights():
    while True:
        amounts=int(input("enter the number of nights stayed and enter '-1' when done: "))
        nights_list.append(amounts)
        if amounts==-1:
            break
guests()
nights()
guest_list.pop()
nights_list.pop()
print(guest_list)
print(nights_list)

if len(nights_list) > len(guest_list):
    missing_g=input("Error, enter missing guest: ").capitalize()
    guest_amount=int(input("enter amount of nights they stayed: "))
    index1=nights_list.index(guest_amount)
    guest_list.insert(index1,missing_g)
    print(f"updated list: {guest_list}")

if len(guest_list) > len(nights_list):
    missing_n=int(input("Error, enter missing night value: "))
    guest_name=input("enter matching name of customer: ").capitalize()
    index2=guest_list.index(guest_name)
    nights_list.insert(index2,missing_n)
